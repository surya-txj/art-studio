# Copy to .env (cp .env.example .env). Every variable is optional; the
# defaults below are what the app uses when a variable is missing.

# Port for the Express API (the Vite dev proxy expects 4000).
PORT=4000

# SQLite database file, relative to the server/ folder. Created automatically.
DATABASE_FILE=data/art-studio.db

# How long a login session lasts, in hours (default 168 = 7 days).
SESSION_TTL_HOURS=168

# bcrypt cost factor for password hashing.
BCRYPT_ROUNDS=10

# Timezone used for "days away" rules on bookings and pottery.
STUDIO_TIMEZONE=Asia/Kolkata

# Optional: password for the studio account, used ONLY when the seed first
# creates it. Leave empty to use the password from server/seed-data/seed.json.
STUDIO_PASSWORD=

# Set to "production" when serving over HTTPS (makes the session cookie Secure).
NODE_ENV=development
